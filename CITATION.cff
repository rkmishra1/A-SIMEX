    given-names: Gaurav
    email: ggarg@iiml.ac.in
    affiliation: "Indian Institute of Management Lucknow"
  - family-names: Mishra
    given-names: Ramakrushna
keywords:
  - measurement error
  - Poisson regression
  - SIMEX
  - simulation extrapolation
  - sandwich variance
  - NHANES
